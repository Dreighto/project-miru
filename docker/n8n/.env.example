## n8n local environment (example)
## Copy this file to .env and fill in any values you need. Never commit .env.
##
## n8n 2.x uses its own email-based user management (not basic auth),
## so there is nothing required here by default. Owner account credentials
## live inside the n8n_data volume, not in this file.
##
## Add entries here if/when you need them, e.g.:
#   N8N_ENCRYPTION_KEY=replace-with-stable-random-string
#   N8N_SMTP_HOST=smtp.example.com
#   N8N_SMTP_USER=...
#   N8N_SMTP_PASS=...

## Pushover user key — referenced by workflows as {{ $env.PUSHOVER_USER_KEY }}.
## Copy the value from D:\dev\miru\.env (PUSHOVER_USER_KEY) into this file's
## sibling `.env` on each host. Never commit the real value.
PUSHOVER_USER_KEY=your_pushover_user_key_here

## Telegram bot API token — used by W2 router + W2 watchdog HTTP Request nodes
## that build dynamic inline keyboards (the native Telegram node cannot accept
## per-call inlineKeyboard payloads as expressions). Copy from D:\dev\miru\.env.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

## Telegram chat ID for the bot's destination (operator's personal chat).
## Numeric, no quotes. Already in D:\dev\miru\.env. Never commit.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

## HMAC secret for callback_data signing on the W7 callback handler.
## 32 hex bytes (64 chars). Generate once: openssl rand -hex 32. Rotation
## invalidates in-flight callbacks signed under the old secret (silent reject;
## acceptable per PRO-37 canon).
TELEGRAM_CALLBACK_SECRET=your_64_char_hex_secret_here
