{
  "name": "W8 — Telegram Command Handler",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "w8001-telegram-trigger",
      "name": "w8001-telegram-trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "webhookId": "w8-telegram-command",
      "credentials": {
        "telegramApi": {
          "id": "5tWWGl8jkCOHqJQg",
          "name": "telegram-n8n"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "w8r1",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "/recent",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w8002-is-recent",
      "name": "w8002-is-recent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForEachItem",
        "jsCode": "// w8003-parse-count\n// Parse /recent [count] from Telegram message text.\n// Default count: 5. Min: 1. Max: 20.\nconst msg = $input.item.json.message || {};\nconst text = (msg.text || '').trim();\nconst chatId = (msg.chat && msg.chat.id != null) ? msg.chat.id : null;\nconst messageId = msg.message_id || null;\n\nconst parts = text.split(/\\s+/);\nlet count = 5;\nif (parts.length >= 2) {\n  const parsed = parseInt(parts[1], 10);\n  if (!isNaN(parsed)) {\n    count = Math.max(1, Math.min(20, parsed));\n  }\n}\n\nreturn { json: { count, chat_id: chatId, message_id: messageId } };"
      },
      "id": "w8003-parse-count",
      "name": "w8003-parse-count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "command": "=pwsh {{ $env.MIRU_REPO_ROOT }}/tools/scripts/recent.ps1 -Count {{ $json.count }}"
      },
      "id": "w8004-exec-recent",
      "name": "w8004-exec-recent",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        860,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForEachItem",
        "jsCode": "// w8005-format-reply\n// Build the Telegram reply from Execute Command output.\n// Returns raw recent.ps1 stdout, or a friendly error if the script failed.\nconst data = $input.item.json;\nconst exitCode = data.exitCode != null ? Number(data.exitCode) : -1;\nconst stdout = (data.stdout || '').trim();\nconst stderr = (data.stderr || '').trim();\n\nlet replyText;\nif (stdout.length > 0) {\n  replyText = stdout;\n} else if (exitCode !== 0 && stderr.length > 0) {\n  replyText = 'Could not retrieve recent completions.\\n' + stderr.substring(0, 200);\n} else {\n  replyText = 'No recent completions found.';\n}\n\n// Telegram max message length is 4096 chars\nif (replyText.length > 4000) {\n  replyText = replyText.substring(0, 3997) + '...';\n}\n\nconst parseData = $('w8003-parse-count').item.json;\nreturn { json: { reply_text: replyText, chat_id: parseData.chat_id, message_id: parseData.message_id } };"
      },
      "id": "w8005-format-reply",
      "name": "w8005-format-reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.reply_text, reply_to_message_id: $json.message_id }) }}",
        "options": {}
      },
      "id": "w8006-send-reply",
      "name": "w8006-send-reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ],
      "continueOnFail": true
    }
  ],
  "connections": {
    "w8001-telegram-trigger": {
      "main": [
