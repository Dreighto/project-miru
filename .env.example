# Miru — environment variable template
# Copy this file to .env and fill in real values before running any service.
# Never commit .env — it holds production secrets.

# ── Core / Auth ──────────────────────────────────────────────────────────────
MIRU_MCP_URL_SECRET=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CALLBACK_SECRET=

# ── AI / LLM APIs ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
ASSEMBLY_AI_API_KEY=

# Cursor Background Agents API key (Pro+ plan required)
# Lives at https://api.cursor.com/v0
# Used by future PRO-85 dispatch path (cloud-side multi-agent execution)
CURSOR_API_KEY=

# ── Data / Search APIs ────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
MAGIC_UI_API_KEY=
YOUTUBE_API_KEY=
JUSTTCG_API_KEY=
MEM0-API-KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHOVER_ENABLED=true
PUSHOVER_DEFAULT_PRIORITY=0

# ── Project management / Git ──────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_TOKEN_READ=
LINEAR_API_KEY=
GH_TOKEN=
GITHUB_TOKEN_READ=
GITHUB_TOKEN_WRITE=

# ── Infrastructure ────────────────────────────────────────────────────────────
TAILSCALE_API_TOKEN=
N8N_API_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=

# ── Local Ollama / Helper model ───────────────────────────────────────────────
MIRU_HELPER_ENABLED=1
MIRU_HELPER_MODEL=gemma4:e4b
MIRU_HELPER_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Service URLs ──────────────────────────────────────────────────────────────
DISPATCHER_BASE_URL=http://127.0.0.1:19000
DISPATCH_LISTENER_URL=http://127.0.0.1:19100

# ── W4 Dispatch Listener (host webhook for headless CLI invocation) ──────────
# Shared HMAC secret for n8n W4 → host listener. Generate locally with:
#   openssl rand -hex 32        # or  openssl rand -base64 32
# The same value must live in n8n's credential store (configured by PRO-84).
W4_LISTENER_HMAC_SECRET=

# ── Local asset paths (Windows — adjust to your machine) ─────────────────────
PROJECT_MIRU_CLEAN_THUMB_ROOT=D:\Miru_Assets
MIRU_RUNTIME_IMAGES_ROOT=D:\Miru_Assets
MIRU_OPTCG_IMAGES_ROOT=D:\OPTCG_Images

# ── Debug flags ───────────────────────────────────────────────────────────────
DEBUG_IMAGES=1
